# .agents/aiignore
# Universal Single Source of Truth (SSOT) for AI Assistant Exclusions
# Synced automatically to .cursorignore, .claudeignore, etc.

# ==============================================================================
# 1. Secrets, Credentials and Environment Files (CRITICAL)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
*_rsa*
*.secret
credentials.json
token.json
secrets.json

# ==============================================================================
# 2. Dependencies and Massive Lockfiles (Token Burn Prevention)
# ==============================================================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
poetry.lock
Pipfile.lock
Cargo.lock
Gemfile.lock
composer.lock
vendor/

# ==============================================================================
# 3. Build Outputs, Binaries and Bundles
# ==============================================================================
dist/
build/
out/
target/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.min.js
*.min.css
*.map

# ==============================================================================
# 4. Cache, Logs and Temporary Artifacts
# ==============================================================================
.cache/
.temp/
tmp/
temp/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================================================================
# 5. OS Metadata and Local Tooling Artifacts
# ==============================================================================
.DS_Store
Thumbs.db
.cursorindexing/
.claude/
*.local
